<% layout('./layouts/boilerplate') -%>

    <body>

        <div class="row">
            <div class="col-8 offset-2 d-flex justify-content-between align-items-center">
                <h1 class="mt-3 mb-2">
                    <%= listing.title %>
                </h1>
                <span class="wishlist-toggle" data-id="<%= listing._id %>" style="cursor: pointer;">
                    <% if(currentUser && currentUser.wishlist && currentUser.wishlist.includes(listing._id)) { %>
                        <i class="fa-solid fa-heart text-danger fs-2 wishlist-heart"></i>
                    <% } else { %>
                        <i class="fa-regular fa-heart text-dark fs-2 wishlist-heart"></i>
                    <% } %>
                </span>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-6 offset-2">
                <div class="card border-0">
                    <img src="<%= listing.image.url %>" class="card-img-top show-img mt-3" alt="listing-Image">
                    <div class="card-body mt-3 px-0">
                        <p class="card-text">
                            Owner: <b><%= listing.owner.username %></b> <br>
                            <%= listing.description %> <br>
                            &#8377;<%= listing.price.toLocaleString("en-IN") %> <br>
                            <%= listing.location %> <br>
                            <%= listing.country %>
                        </p>
                    </div>
                </div>
                <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
                <div class="btns mb-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn col-2 me-3">Edit</a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
                <% } %>
            </div>
            <div class="col-4">
                <!-- Booking Form -->
                <% if(currentUser && !currentUser._id.equals(listing.owner._id)) { %>
                <div class="card p-4 shadow-sm border mt-3 rounded-4">
                    <h4 class="mb-3">Request a Booking</h4>
                    <form action="/listings/<%= listing._id %>/book" method="POST">
                        <div class="mb-3">
                            <label for="checkInDate" class="form-label">Check-in</label>
                            <input type="date" class="form-control" id="checkInDate" name="checkInDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="checkOutDate" class="form-label">Check-out</label>
                            <input type="date" class="form-control" id="checkOutDate" name="checkOutDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="totalGuests" class="form-label">Guests</label>
                            <input type="number" class="form-control" id="totalGuests" name="totalGuests" min="1" value="1" required>
                        </div>
                        <button type="submit" class="btn add-btn w-100 text-white rounded-3 py-2">Request Booking</button>
                    </form>
                    <script>
                        const today = new Date().toISOString().split('T')[0];
                        document.getElementById('checkInDate').setAttribute('min', today);
                        
                        document.getElementById('checkInDate').addEventListener('change', function() {
                            const checkIn = this.value;
                            document.getElementById('checkOutDate').setAttribute('min', checkIn);
                            // Set checkout date to at least 1 day after checkin if it's earlier
                            const checkOutElem = document.getElementById('checkOutDate');
                            if (checkOutElem.value && checkOutElem.value <= checkIn) {
                                let nextDay = new Date(checkIn);
                                nextDay.setDate(nextDay.getDate() + 1);
                                checkOutElem.value = nextDay.toISOString().split('T')[0];
                            }
                        });
                    </script>
                </div>
                <% } else if(!currentUser) { %>
                <div class="card p-4 shadow-sm border mt-3 rounded-4 text-center">
                    <h4>Request a Booking</h4>
                    <p class="text-muted mt-2">Log in to request a booking for this listing.</p>
                    <a href="/login" class="btn add-btn text-white w-100 rounded-3 mt-3">Log In</a>
                </div>
                <% } else { %>
                <div class="card p-4 shadow-sm border mt-3 rounded-4 text-center bg-light">
                    <h4>Your Listing</h4>
                    <p class="text-muted mt-2">You cannot book your own listing.</p>
                </div>
                <% } %>
            </div>
        </div>
        <hr>

        <div class="col-8 offset-2 mb-3 mt-3">
            <% if(currentUser) { %>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <!-- <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div> -->

                <div class="mt-3">
                <h4>Leave a Review</h4>
                <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-dark add-btn">Submit</button>
            </form>
            <% } %>

            <% if(listing.reviews.length> 0) { %>
                <hr>
                <div class="row">
                    <p><b>All Reviews</b></p>
                    <% for(review of listing.reviews) { %>
                        <div class="card col-5 ms-3 mb-3 border border-dark border-1 shadow-sm review-card">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>
                                <p class="starability-result card" data-rating="<%= review.rating %>">
                                 </p>
                                <% if(currentUser && currentUser._id.equals(review.author._id)) { %>
                                <form class="mb-3" method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-dark" style="border-radius: 15px;">Delete</button>
                                </form>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                </div>
                <% } %>
        </div>



    </body>