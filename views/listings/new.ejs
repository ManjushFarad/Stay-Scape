<% layout('layouts/boilerplate') %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="mt-3 mb-3">Add New Listing</h3>

            <form method="post" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
                
                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" class="form-control" placeholder="Enter Listing Title" required>
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" rows="5" class="form-control" required></textarea>
                    <div class="valid-feedback">Looks Proper Description</div>
                </div>

    
                 <!-- Image -->
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input type="file" name="listing[image]" class="form-control"required>
                </div>

                <!-- Price + Location -->
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Add Price</label>
                        <input type="number" name="listing[price]" class="form-control" placeholder="Price" required>
                        <div class="invalid-feedback">Please enter a valid price</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Add Location</label>
                        <input type="text" name="listing[location]" class="form-control" placeholder="Location" required>
                        <div class="invalid-feedback">Please enter a valid location</div>
                    </div>
                </div>

                <!-- Country -->
                <div class="mb-3">
                    <label for="country" class="form-label">Add Country</label>
                    <input type="text" name="listing[country]" class="form-control" placeholder="Country" required>
                    <div class="invalid-feedback">Please enter a valid country</div>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label for="category" class="form-label">Select Category</label>
                    <select name="listing[category]" class="form-control" required>
                        <option value="" disabled selected>Choose a category</option>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Farms">Farms</option>
                        <option value="Camping">Camping</option>
                        <option value="Castles">Castles</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Beach Houses">Beach Houses</option>
                        <option value="Villas">Villas</option>
                        <option value="Cottages">Cottages</option>
                        <option value="Luxury">Luxury</option>
                    </select>
                    <div class="invalid-feedback">Please select a category</div>
                </div>

                <button class="btn btn-dark mb-3 add-btn">Add Listing</button>
            </form>
        </div>
    </div>
</body>
</html>