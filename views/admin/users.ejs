<% layout('./layouts/admin') -%>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">User Management</h2>
    <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 shadow-sm"><%= users.length %> Users</span>
</div>

<div class="admin-table-container">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">User</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Email</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Role</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(user of users) { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                                    <i class="fa-solid fa-user text-primary"></i>
                                </div>
                                <span class="fw-bold text-dark">@<%= user.username %></span>
                            </div>
                        </td>
                        <td class="text-muted"><%= user.email %></td>
                        <td>
                            <% if(user.role === 'admin') { %>
                                <span class="badge badge-soft-danger px-3 py-2 rounded-pill">Admin</span>
                            <% } else { %>
                                <span class="badge badge-soft-secondary px-3 py-2 rounded-pill">User</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <form action="/admin/users/<%= user._id %>?_method=DELETE" method="POST" class="m-0 d-inline" onsubmit="return confirm('WARNING: This will cascade delete all listings, reviews, and bookings owned by this user. Continue?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
