<% layout('./layouts/admin') -%>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Review Management</h2>
    <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6 shadow-sm"><%= reviews.length %> Reviews</span>
</div>

<div class="admin-table-container">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Author</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Rating</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Comment</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(review of reviews) { %>
                    <tr>
                        <td>
                            <span class="badge badge-soft-secondary px-3 py-2 rounded-pill">@<%= review.author.username %></span>
                        </td>
                        <td>
                            <div class="bg-light-warning d-inline-block px-3 py-1 rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-star text-warning"></i> <%= review.rating %>
                            </div>
                        </td>
                        <td class="text-muted" style="max-width: 350px;">
                            <p class="text-truncate mb-0" title="<%= review.comment %>">"<%= review.comment %>"</p>
                        </td>
                        <td class="text-end">
                            <form action="/admin/reviews/<%= review._id %>?_method=DELETE" method="POST" class="m-0 d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
