<% layout('./layouts/admin') -%>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Listing Management</h2>
    <span class="badge bg-success rounded-pill px-3 py-2 fs-6 shadow-sm"><%= listings.length %> Listings</span>
</div>

<div class="admin-table-container">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Listing</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Owner</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Location</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(listing of listings) { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="<%= listing.image.url %>" alt="listing" class="rounded-3 shadow-sm me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                <a href="/listings/<%= listing._id %>" class="text-dark text-decoration-none fw-bold"><%= listing.title %></a>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-soft-secondary px-3 py-2 rounded-pill">@<%= listing.owner.username %></span>
                        </td>
                        <td class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %></td>
                        <td class="text-end">
                            <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST" class="m-0 d-inline" onsubmit="return confirm('Are you sure you want to delete this listing and its reviews?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
