<% layout('./layouts/admin') -%>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Booking Management</h2>
    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6 shadow-sm"><%= bookings.length %> Requests</span>
</div>

<div class="admin-table-container">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Listing</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Guest</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Host</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Dates</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold">Status</th>
                    <th class="text-muted text-uppercase fs-7 fw-semibold text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(booking of bookings) { %>
                    <tr>
                        <td>
                            <% if (booking.listing) { %>
                                <div class="d-flex align-items-center">
                                    <img src="<%= booking.listing.image.url %>" class="rounded-3 shadow-sm me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                    <a href="/listings/<%= booking.listing._id %>" class="text-dark text-decoration-none fw-bold text-truncate d-inline-block" style="max-width: 150px;"><%= booking.listing.title %></a>
                                </div>
                            <% } else { %>
                                <span class="text-muted"><i class="fa-solid fa-ghost me-1"></i> Deleted</span>
                            <% } %>
                        </td>
                        <td><span class="badge badge-soft-secondary rounded-pill">@<%= booking.guest ? booking.guest.username : 'Unknown' %></span></td>
                        <td><span class="badge badge-soft-secondary rounded-pill">@<%= booking.host ? booking.host.username : 'Unknown' %></span></td>
                        <td class="text-muted fs-7">
                            <div class="d-flex flex-column">
                                <span><i class="fa-solid fa-arrow-right-to-bracket text-success me-1"></i> <%= booking.checkInDate.toLocaleDateString('en-GB') %></span>
                                <span><i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i> <%= booking.checkOutDate.toLocaleDateString('en-GB') %></span>
                            </div>
                        </td>
                        <td>
                            <% if(booking.status === 'Pending') { %>
                                <span class="badge badge-soft-warning px-3 py-2 rounded-pill"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                            <% } else if(booking.status === 'Accepted') { %>
                                <span class="badge badge-soft-success px-3 py-2 rounded-pill"><i class="fa-solid fa-check me-1"></i> Accepted</span>
                            <% } else if(booking.status === 'Rejected') { %>
                                <span class="badge badge-soft-danger px-3 py-2 rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Rejected</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <form action="/admin/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="m-0 d-inline" onsubmit="return confirm('Are you sure you want to delete this booking request?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
