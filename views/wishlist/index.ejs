<% layout('./layouts/boilerplate') -%>

<body>
    <h3 class="mt-3 mb-3">My Wishlist</h3>
    <% if(allListings && allListings.length > 0) { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for(listing of allListings){ %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col">
                        <div class="card-img-overlay"></div>
                        <span class="wishlist-toggle position-absolute top-0 end-0 m-3 z-3" data-id="<%= listing._id %>">
                            <% if(currentUser && currentUser.wishlist && currentUser.wishlist.includes(listing._id)) { %>
                                <i class="fa-solid fa-heart text-danger fs-3 wishlist-heart"></i>
                            <% } else { %>
                                <i class="fa-regular fa-heart text-white fs-3 wishlist-heart"></i>
                            <% } %>
                        </span>
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
                        <div class="card-body">
                            <p class="card-text"><b><%= listing.title %></b>
                                <br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %> /night
                                <br>
                                <i class="tax-switch">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
    <% } else { %>
        <div class="alert alert-info mt-4" role="alert">
            Your wishlist is empty! Explore our listings and add your favorites.
        </div>
        <a href="/listings" class="btn btn-dark">Explore Listings</a>
    <% } %>

</body>
