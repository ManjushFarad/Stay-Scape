<% layout('./layouts/boilerplate') -%>

<body>
    <h3 class="mt-3 mb-4">My Bookings</h3>
    <% if(bookings && bookings.length > 0) { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for(booking of bookings) { %>
                <div class="col">
                    <div class="card mb-4 shadow-sm border-0">
                        <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark">
                            <img src="<%= booking.listing.image.url %>" class="card-img-top" alt="Listing Image" style="height: 15rem; object-fit: cover;">
                        </a>
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark">
                                    <%= booking.listing.title %>
                                </a>
                            </h5>
                            <p class="card-text text-muted mb-2">
                                <i class="fa-regular fa-calendar"></i>
                                <%= booking.checkInDate.toLocaleDateString('en-GB') %> - <%= booking.checkOutDate.toLocaleDateString('en-GB') %>
                            </p>
                            <p class="card-text text-muted mb-3">
                                <i class="fa-solid fa-users"></i> <%= booking.totalGuests %> Guest(s)
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <% if(booking.status === 'Pending') { %>
                                        <span class="badge bg-warning text-dark fs-6"><i class="fa-solid fa-clock"></i> Pending</span>
                                    <% } else if(booking.status === 'Accepted') { %>
                                        <span class="badge bg-success fs-6"><i class="fa-solid fa-check"></i> Accepted</span>
                                    <% } else if(booking.status === 'Rejected') { %>
                                        <span class="badge bg-danger fs-6"><i class="fa-solid fa-xmark"></i> Rejected</span>
                                    <% } %>
                                </div>
                                <form action="/my-bookings/<%= booking._id %>?_method=DELETE" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"><i class="fa-solid fa-ban me-1"></i> Cancel</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="alert alert-info mt-4" role="alert">
            You haven't requested any bookings yet!
        </div>
        <a href="/listings" class="btn btn-dark">Explore Listings</a>
    <% } %>
</body>
