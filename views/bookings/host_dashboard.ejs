<% layout('./layouts/boilerplate') -%>

<body>
    <h3 class="mt-3 mb-4">Host Dashboard - Booking Requests</h3>
    <% if(bookings && bookings.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Listing</th>
                        <th>Guest</th>
                        <th>Dates</th>
                        <th>Guests</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(booking of bookings) { %>
                        <tr>
                            <td><a href="/listings/<%= booking.listing ? booking.listing._id : '#' %>" class="text-decoration-none text-dark fw-bold"><%= booking.listing ? booking.listing.title : 'Deleted Listing' %></a></td>
                            <td>@<%= (booking.guest && booking.guest.username) ? booking.guest.username : 'Unknown' %></td>
                            <td>
                                <%= booking.checkInDate.toLocaleDateString('en-GB') %> to <br>
                                <%= booking.checkOutDate.toLocaleDateString('en-GB') %>
                            </td>
                            <td><%= booking.totalGuests %></td>
                            <td>
                                <% if(booking.status === 'Pending') { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else if(booking.status === 'Accepted') { %>
                                    <span class="badge bg-success">Accepted</span>
                                <% } else if(booking.status === 'Rejected') { %>
                                    <span class="badge bg-danger">Rejected</span>
                                <% } %>
                            </td>
                            <td>
                                <% if(booking.status === 'Pending') { %>
                                    <div class="d-flex gap-2">
                                        <form action="/host/bookings/<%= booking._id %>/Accepted" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>
                                        <form action="/host/bookings/<%= booking._id %>/Rejected" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted">No actions available</span>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info mt-4" role="alert">
            You don't have any incoming booking requests.
        </div>
    <% } %>
</body>
